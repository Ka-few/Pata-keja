# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=patanyumba
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patanyumba?schema=public

# Backend
PORT=4000
JWT_SECRET=super-secret-key
REFRESH_TOKEN_SECRET=another-super-secret-key

# M-PESA Daraja
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=your_shortcode
MPESA_CALLBACK_URL=https://your-domain.com/payments/callback

# Cloudflare R2
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=patanyumba-media
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
